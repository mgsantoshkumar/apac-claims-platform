# Copy to .env and adjust for local or cloud deployments.

POSTGRES_DB=claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims
POSTGRES_PORT=15432

REDIS_PORT=16379

KAFKA_PORT=19092
# Host advertised to clients outside Compose (use localhost for local; cloud LB/DNS in cloud)
KAFKA_ADVERTISED_HOST=localhost

CLAIMS_SERVICE_PORT=18081
NOTIFICATION_SERVICE_PORT=18082
FRONTEND_PORT=14200

# Browser-reachable API URLs baked into the frontend image at build time
CLAIMS_API_PUBLIC_URL=http://localhost:18081
NOTIFICATIONS_API_PUBLIC_URL=http://localhost:18082

CORS_ORIGINS=http://localhost:14200,http://127.0.0.1:14200
JWT_SECRET=chubb-apac-claims-mvp-secret-key-change-in-cloud
